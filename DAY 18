            int choice = sc.nextInt();
            switch (choice) {
                case 1:
                    int d = sc.nextInt();
                    s.push(d);
                    break;
                case 2:
                    s.pop();
                    break;
                case 3:
                    s.peek();
                    break;
                case 4:
                    s.display();
                    break;
                case 5:
                    return;
                default:

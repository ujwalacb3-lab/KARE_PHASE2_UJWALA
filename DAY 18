    Queue(int n) {
        data = new int[n];
        front = 0;
        rear = -1;
        size = 0;
    }
    public void enqueue(int value) {
        if (size == data.length) {
            System.out.println("Queue is full");
            return;
        }
        rear = (rear + 1) % data.length;
        data[rear] = value;
        size++;
    }
    public int dequeue() {
        if (size == 0)
            return -1;
        int value = data[front];
        front = (front + 1) % data.length;
        size--;
        return value;
    }
    public boolean isEmpty() {
        return size == 0;
    }
}
class Stack {
    Queue q1, q2;
    Stack(int n) {
        q1 = new Queue(n);
        q2 = new Queue(n);
    }
    public void push(int value) {
        q2.enqueue(value);
        while (!q1.isEmpty()) {
            q2.enqueue(q1.dequeue());
        }
        Queue temp = q1;
        q1 = q2;
        q2 = temp;
        System.out.println(value + " pushed into stack");
    }
    public void pop() {
        if (q1.isEmpty()) {
            System.out.println("Stack Underflow");
            return;
        }
        int value = q1.dequeue();
        System.out.println("Popped element: " + value);
    }
    public void peek() {
        if (q1.isEmpty()) {
            System.out.println("Stack is empty");
            return;
        }
        int value = q1.dequeue();
        q2.enqueue(value);
        while (!q1.isEmpty()) {
            q2.enqueue(q1.dequeue());
        }
        Queue temp = q1;
        q1 = q2;
        q2 = temp;
        System.out.println("Top element: " + value);
    }
    public void display() {
        if (q1.isEmpty()) {
            System.out.println("Stack is empty");
            return;
        }
        System.out.print("Stack Elements: ");
        while (!q1.isEmpty()) {
            int value = q1.dequeue();
            System.out.print(value + " ");
            q2.enqueue(value);
        }
        Queue temp = q1;
        q1 = q2;
        q2 = temp;
        System.out.println();
    }
}

// DEQUE WITH ARRAY
import java.util.*;
class Deque {
    int arr[];
    int front, rear, n;
    Deque(int n) {
        this.n = n;
        arr = new int[n];
        front = -1;
        rear = -1;
    }
    void addFirst(int data) {
        if (front == 0 && rear == n - 1) {
            System.out.println("Deque is full");
            return;
        }
        if (front == -1) {
            front = rear = 0;
        } else if (front > 0) {
            front--;
        } else {
            for (int i = rear; i >= front; i--)
                arr[i + 1] = arr[i];
            rear++;
        }
        arr[front] = data;
    }
    void addLast(int data) {
        if (rear == n - 1) {
            System.out.println("Deque is full");
            return;
        }
        if (front == -1)
            front = 0;
        arr[++rear] = data;
    }
    void removeFirst() {
        if (front == -1) {
            System.out.println("Deque is empty");
            return;
        }
        System.out.println("Deleted: " + arr[front]);
        if (front == rear)
            front = rear = -1;
        else
            front++;
    }
    void removeLast() {
        if (rear == -1) {
            System.out.println("Deque is empty");
            return;
        }
        System.out.println("Deleted: " + arr[rear]);
        if (front == rear)
            front = rear = -1;
        else
            rear--;
    }
    void display() {
        if (front == -1) {
            System.out.println("Deque is empty");
            return;
        }
        for (int i = front; i <= rear; i++)
            System.out.print(arr[i] + " ");
        System.out.println();
    }
}
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        Deque d = new Deque(n);
        while (true) {
            System.out.println("\n1. Add First");
            System.out.println("2. Add Last");
            System.out.println("3. Remove First");
            System.out.println("4. Remove Last");
            System.out.println("5. Display");
            System.out.println("6. Exit");
            int choice = sc.nextInt();
            switch (choice) {
                case 1:
                    d.addFirst(sc.nextInt());
                    break;
                case 2:
                    d.addLast(sc.nextInt());
                    break;
                case 3:
                    d.removeFirst();
                    break;
                case 4:
                    d.removeLast();
                    break;
                case 5:
                    d.display();
                    break;
                case 6:
                    return;
                default:
                    System.out.println("Invalid Choice");
            }
        }
    }
}

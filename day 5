import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int ec=0,oc=0,d;
        while(n!=0)
        {
            d=n%10;
            if(d%2==0)
            ec++;
            else
            oc++;
            n=n/10;
        }
        System.out.print("Odd digit count:"+oc);
        System.out.print("Even digit count:"+ec);
    }
}

import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int c=0,d;
        while(n!=0)
        {
            d=n%10;
            if(d==2||d==3||d=5||d==7)
            c++;
            n=n/10;
        }
        System.out.print("Prime digit count:"+c);
    }
}

import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        char c = sc.next().CharAt(0);
        switch(c)
        {
            Case '+':
                System.out.print(a + b);
                break;
            Case '-':
                System.out.print(a - b);
                break;
            Case '*':
                System.out.print(a * b);
                break;
            Case '/':
                System.out.print(a / b);
                break;
            Case '%';
                System.out.print(a % b);
                break;
            default:
                System.out.print("Invalid")
            
        }
    }
}


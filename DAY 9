//8)to find the  smallest value
//i/p                o/p
 // 5               
 // 10 20 50 25 60  50
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[]=new int[n];
        int i,max,smax;
        for(i=0;i<n;i++){
        arr[i]=sc.nextInt();
        }
        if(arr[0]>arr[1])
        {
            max=arr[0];
            smax = arr[1];
        }
        else{
            max = arr[1];
            smax = arr[0];
        }
        for(i = 2;i<n;i++){
            if(arr[i]>max){
                smax = max;
                max = arr[i];
            }
            else if(arr[i]>smax && arr[i]<max){
            smax=arr[i];
            }
        }
        System.out.print(smax);
        
  }
            
}

class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n = sc.nextInt();
        int c = 0,d;
        while(n!=0)
        {
            d = n%10;
            if(d==2||d==3||d==5||d==7)
            c++;
            n=n/10;
        }
        System.out.print("prime digit count:"+c);
    }
}


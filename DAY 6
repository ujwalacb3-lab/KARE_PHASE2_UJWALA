class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int square = n * n;
        int temp=n;
        int sum = 0, d;
        while(square != 0) {
            d = square % 10;
            sum = sum + d;
            square = square / 10;
        }
        if (sum == n)
        System.out.print("NEON NUMBER");
        else
        System.out.print("NOT A NEON NUMBER");
    }
    
}

9)//perfect number

import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int i,sum=0;
        for(i=1;i<=n/2;i++)
        {
            if(n%i==0)
            sum+=i;
        }
        if(sum==n)
        System.out.print("perfect number");
        else
        System.out.print("not a perfect number");
    }
    
}

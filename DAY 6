2)reverse the number 4821

import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n = sc.nextInt();
        int d,ans = 0;
        while(n!=0)
        {
            d=n%10;
            ans=ans*10+d;
            n=n/10;
        }
        System.out.print("Reverse Number:"+ans);
    }
}

3)//i/p      o/p
//4821     odd digit count:1
//         even digit count:3

import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n = sc.nextInt();
        int ec=0,oc=0,d;
        while(n!=0)
        {
            d = n%10;
            if(d%2==0)
            ec++;
            else
            oc++;
            n=n/10;
        }
        System.out.print("odd digit count:"+oc);
        System.out.print("even digit count:"+ec);
    }
}



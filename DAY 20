// STACK USING INBUILT METHODS
import java.util.*;
class Main {
    public static void main(String[] args) {
        Stack<Integer> obj = new Stack<Integer>();
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        for (int i = 0; i < n; i++)
            obj.push(s.nextInt());
        System.out.println("Stack: " + obj);
        int value = s.nextInt();
        obj.push(value);
        System.out.println("After push: " + obj);
        System.out.println("Peek: " + obj.peek());
        obj.pop();
        System.out.println("After pop: " + obj);
        value = s.nextInt();
        System.out.println("Search: " + obj.search(value));
        value = s.nextInt();
        System.out.println("Contains: " + obj.contains(value));
        System.out.println("Size: " + obj.size());
        System.out.println("Is Empty: " + obj.isEmpty());
        obj.clear();
        System.out.println("After clear: " + obj);
        System.out.println("Is Empty: " + obj.isEmpty());
    }
}


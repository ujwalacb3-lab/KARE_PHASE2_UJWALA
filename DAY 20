// LINKEDLIST WITH INBUILT METHODS
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        LinkedList<Integer> obj = new LinkedList<>();
        int n = sc.nextInt();
        for (int i = 0; i < n; i++) {
            obj.add(sc.nextInt());
        }
        System.out.println("LinkedList: " + obj);
        int ind = sc.nextInt();
        int val = sc.nextInt();
        obj.add(ind, val);
        System.out.println("After add(index,value): " + obj);
        int d = sc.nextInt();
        obj.addFirst(d);
        System.out.println("After addFirst: " + obj);
        d = sc.nextInt();
        obj.addLast(d);
        System.out.println("After addLast: " + obj);
        ind = sc.nextInt();
        System.out.println("get: " + obj.get(ind));
        System.out.println("getFirst: " + obj.getFirst());
        d = sc.nextInt();
        obj.remove(Integer.valueOf(d));
        System.out.println("After remove(value): " + obj);
        ind = sc.nextInt();
        obj.remove(ind);
        System.out.println("After remove(index): " + obj);
        obj.removeFirst();
        System.out.println("After removeFirst: " + obj);
        obj.removeLast();
        System.out.println("After removeLast: " + obj);
        d = sc.nextInt();
        System.out.println("Contains " + d + ": " + obj.contains(d));
        System.out.println("Size: " + obj.size());
        System.out.println("Is Empty: " + obj.isEmpty());
        obj.clear();
        System.out.println("After clear: " + obj);
        System.out.println("Is Empty: " + obj.isEmpty());
    }
}


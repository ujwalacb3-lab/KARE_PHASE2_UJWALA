// ARRAYLIST USING INBUILT METHODS
import java.util.*;
class Main {
    public static void main(String[] args) {
        ArrayList<Integer> obj = new ArrayList<Integer>();
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        for (int i = 0; i < n; i++)
            obj.add(s.nextInt());
        System.out.println("ArrayList: " + obj);
        int index = s.nextInt();
        int value = s.nextInt();
        obj.add(index, value);
        System.out.println("After add: " + obj);
        index = s.nextInt();
        System.out.println("get: " + obj.get(index));
        index = s.nextInt();
        value = s.nextInt();
        obj.set(index, value);
        System.out.println("After set: " + obj);
        index = s.nextInt();
        obj.remove(index);
        System.out.println("After remove: " + obj);
        System.out.println("Size: " + obj.size());
        value = s.nextInt();
        System.out.println("Contains: " + obj.contains(value));
        value = s.nextInt();
        System.out.println("IndexOf: " + obj.indexOf(value));
        value = s.nextInt();
        System.out.println("LastIndexOf: " + obj.lastIndexOf(value));
        ArrayList<Integer> removeList = new ArrayList<Integer>();
        int r = s.nextInt();
        for (int i = 0; i < r; i++)
            removeList.add(s.nextInt());
        obj.removeAll(removeList);
        System.out.println("After removeAll: " + obj);
        ArrayList<Integer> retainList = new ArrayList<Integer>();
        int x = s.nextInt();
        for (int i = 0; i < x; i++)
            retainList.add(s.nextInt());
        obj.retainAll(retainList);
        System.out.println("After retainAll: " + obj);
        System.out.println("Is Empty: " + obj.isEmpty());
        obj.clear();
        System.out.println("After clear: " + obj);
        System.out.println("Is Empty: " + obj.isEmpty());
    }
}

